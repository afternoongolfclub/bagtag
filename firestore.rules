rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read and write their own clubs subcollection.
    match /users/{userId}/clubs/{clubId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Email → uid lookup so clubs can be moved to another user by email.
    // Anyone signed in can look up a single email (no listing); each user
    // can only write the entry for their own email.
    match /userDirectory/{email} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.token.email != null
        && email == request.auth.token.email.lower()
        && request.resource.data.uid == request.auth.uid;
    }

    // Club moves between users. Only the sender and recipient can see one.
    match /transfers/{transferId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      // Sender creates a pending move to someone else
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending';

      // Recipient accepts or declines; they may change nothing else
      allow update: if request.auth != null
        && resource.data.toUid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      // Sender cancels, or cleans up after the recipient answers
      allow delete: if request.auth != null && resource.data.fromUid == request.auth.uid;
    }

    // Deny everything else explicitly.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
